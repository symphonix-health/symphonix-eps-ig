{
  "project_name": "symphonix-eps-ig",
  "platform": "fullstack",
  "infrastructure": {
    "redis": {
      "reason": "Caching frequently accessed data or distributed session/rate limiting",
      "env": "REDIS_URL=redis://localhost:6379/0",
      "dependency": "redis>=5.0.0"
    },
    "kafka": {
      "reason": "Durable event streaming across services",
      "env": "USE_KAFKA=1",
      "dependency": "aiokafka>=0.9.0"
    },
    "file_storage": {
      "reason": "Object storage for user uploads and generated files",
      "env": "S3_BUCKET=my-bucket",
      "dependency": "boto3>=1.34.0"
    },
    "websocket": {
      "reason": "Two-way real-time communication",
      "env": "BT_ENABLE_REALTIME=true",
      "dependency": "websockets>=12.0"
    }
  },
